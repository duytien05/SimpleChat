  void initState() {
    super.initState();
    _loadMyProfile();

    // Mỗi khi người dùng vào nhóm chat, tự động đánh dấu các tin nhắn mới là "Đã xem"
    ChatInteractionService.markMessagesAsRead(
      chatId: widget.chatId,
      currentUserId: currentUserId,
