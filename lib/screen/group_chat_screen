                                          : const Color(
                                              0xFFF1F0F0),
                                      borderRadius:
                                          BorderRadius.only(
                                        topLeft:
                                            const Radius
                                                .circular(
                                                16),
                                        topRight:
                                            const Radius
                                                .circular(
                                                16),
                                        bottomLeft:
                                            Radius.circular(
                                                isMe
