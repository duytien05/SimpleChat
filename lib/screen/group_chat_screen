// COMPONENT TỰ ĐỘNG MAP AVATAR THÀNH VIÊN REALTIME
class GroupSenderAvatarWidget extends StatelessWidget {
  final String senderId;
  final String fallbackName;

  const GroupSenderAvatarWidget({
    super.key,
    required this.senderId,
    required this.fallbackName,
  });

  ImageProvider? _parseAvatar(String photoUrl) {
    if (photoUrl.isEmpty) return null;
    if (photoUrl.startsWith('data:image')) {
      try {
        final base64String = photoUrl.split(',')[1];
        return MemoryImage(base64Decode(base64String));
      } catch (_) {
        return null;
      }
    }
    return NetworkImage(photoUrl);
  }

  @override
  Widget build(BuildContext context) {
    if (senderId.isEmpty) {
      return CircleAvatar(
        radius: 16,
        backgroundColor: const Color(0xFF0068FF),
        child: Text(
            fallbackName.isNotEmpty
                ? fallbackName[0].toUpperCase()
                : 'U',
            style: const TextStyle(
                fontSize: 13,
                color: Colors.white,
                fontWeight: FontWeight.bold)),
      );
    }

    return StreamBuilder<DocumentSnapshot>(
      stream: FirebaseFirestore.instance
          .collection('users')
          .doc(senderId)
          .snapshots(),
      builder: (context, snapshot) {
        String photoUrl = '';
        if (snapshot.hasData && snapshot.data!.exists) {
          var data =
              snapshot.data!.data() as Map<String, dynamic>;
          photoUrl = data['photoUrl'] ?? '';
        }

        final imageProvider = _parseAvatar(photoUrl);

        return CircleAvatar(
          radius: 16,
          backgroundColor: const Color(0xFF0068FF),
          backgroundImage: imageProvider,
          child: imageProvider == null
              ? Text(
                  fallbackName.isNotEmpty
                      ? fallbackName[0].toUpperCase()
                      : 'U',
                  style: const TextStyle(
                      fontSize: 13,
                      color: Colors.white,
                      fontWeight: FontWeight.bold),
                )
              : null,
        );
      },
    );
  }
}
