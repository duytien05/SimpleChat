                                                    : 0),
                                        bottomRight:
                                            Radius.circular(
                                                isMe
                                                    ? 0
                                                    : 16),
                                      ),
                                      border: isMe &&
                                              !isRevoked
                                          ? null
                                          : Border.all(
                                              color: Colors
                                                      .grey[
                                                  200]!),
                                      boxShadow: [
                                        BoxShadow(
                                          color: Colors
                                              .black
                                              .withOpacity(
                                                  0.01),
                                          blurRadius: 2,
                                          offset:
                                              const Offset(
                                                  0, 1),
                                        )
                                      ],
                                    ),
                                    child:
                                        _buildMessageBody(
                                            type,
                                            messageText,
                                            isRevoked,
                                            isMe),
                                  ),
                                  if (isMe && !isRevoked)
                                    Padding(
                                      padding:
                                          const EdgeInsets
                                              .only(
                                              right: 4,
                                              top: 3,
                                              bottom: 2),
                                      child: Text(
                                        readByList.length >
